# encoding
AddDefaultCharset UTF-8
# DefaultLanguage
DefaultLanguage pt-BR

RewriteEngine On

# (Removido o bloco de redirecionamento HTTPS para evitar loops com o Easypanel)

RewriteRule ^$ index.php [NC,L]
RewriteRule ^quemsomos/?$ quemsomos\.php [NC,L]
RewriteRule ^servicos/?$ servicos\.php [NC,L]
RewriteRule ^nossodiferencial/?$ nossodiferencial\.php [NC,L]
RewriteRule ^como-comprar-pagar/?$ comocomprarpagar\.php [NC,L]
RewriteRule ^parceiros/?$ parceiros\.php [NC,L]
RewriteRule ^contato/?$ contato\.php [NC,L]
RewriteRule ^esqueci-minha-senha/?$ esqueci-minha-senha\.php [NC,L]
RewriteRule ^pedidos/?$ pedidos\.php [NC,L]
RewriteRule ^login/?$ login\.php [NC,L]
RewriteRule ^dados-cadastrais/?$ dados-cadastrais\.php [NC,L]
RewriteRule ^checkout/?$ checkout_payment\.php [NC,L]
RewriteRule ^fachada/?([0-9-]+)?$ fachada\.php\?id=$1 [NC,L]
RewriteRule ^agenda/?$ agenda-online\.php [NC,L]
RewriteRule ^planta/?([0-9-]+)?$ planta\.php\?id=$1 [NC,L]
RewriteRule ^cursos/?([a-z0-9-]+)?/?$ curso\.php\?slug=$1 [NC,L]
RewriteRule ^sobre_a_minds/?$ aminds\.php [NC,L]
RewriteRule ^quero_desconto/?$ querodesconto\.php [NC,L]
RewriteRule ^quero_desconto_ok/?$ querodesconto_ok\.php [NC,L]
RewriteRule ^seja_um_franqueado/?$ sejaumfranqueado\.php [NC,L]
RewriteRule ^clube_de_beneficios/?$ clubedebeneficios\.php [NC,L]
RewriteRule ^webmail/?$ webmail\.php [NC,L]
RewriteRule ^fale_conosco/?$ faleconosco\.php [NC,L]
RewriteRule ^descubra/?$ descubra\.php [NC,L]
RewriteRule ^pratique/?$ pratique\.php [NC,L]
RewriteRule ^galerias_de_imagens/?$ galeriasimagens\.php [NC,L]
RewriteRule ^evento_imagens/?([a-z0-9-]+)?/?$ galeriaimagem\.php\?slug=$1 [NC,L]
RewriteRule ^galerias_de_videos/?$ galeriasvideos\.php [NC,L]
RewriteRule ^noticias/?$ noticia\.php [NC,L]
RewriteRule ^noticia/?([0-9-]+)?$ noticia\.php\?id=$1 [NC,L]
RewriteRule ^checkout/?([a-z0-9-]+)?/?$ checkout\.php [NC,L]
RewriteRule ^pagseguro/?([a-z0-9-]+)?/?$ pagseguro\.php [NC,L]
